# =============================================================================
# Secrets para crivo-prod  (uso: scripts/create-app-secrets.sh prod)
# Copie para config/secrets.prod.env (gitignored) e preencha.
# =============================================================================

# -- Keycloak admin ----------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password

# -- Keycloak DB -------------------------------------------------------------
KC_DB_URL=jdbc:postgresql://172.19.0.11:5432/crivo_keycloak_prod
KC_DB_USERNAME=crivo
KC_DB_PASSWORD=change-me

# -- Backend / app -----------------------------------------------------------
DATABASE_URL=postgresql://crivo:change-me@172.19.0.11:5432/crivo_app_prod?schema=public
KEYCLOAK_CLIENT_SECRET=change-me
BETTER_AUTH_SECRET=change-me-better-auth-prod

# -- Cloudinary --------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=devops-prod

# -- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TRIAL=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# -- Mail --------------------------------------------------------------------
MAILTRAP_HOST=
MAILTRAP_PORT=587
MAILTRAP_USER=
MAILTRAP_PASSWORD=

# -- AI ----------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -- Storage / S3 ------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
