# =============================================================================
# Secrets para crivo-develop  (uso: scripts/create-app-secrets.sh develop)
# Copie para config/secrets.develop.env (gitignored) e preencha.
# =============================================================================

# -- Keycloak admin ----------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# -- Keycloak DB (Postgres rodando no docker, na rede k3d-devops-lab) --------
KC_DB_URL=jdbc:postgresql://172.19.0.11:5432/crivo_keycloak
KC_DB_USERNAME=crivo
KC_DB_PASSWORD=crivo_password

# -- Backend / app -----------------------------------------------------------
DATABASE_URL=postgresql://crivo:crivo_password@172.19.0.11:5432/crivo_app?schema=public
KEYCLOAK_CLIENT_SECRET=change-me
BETTER_AUTH_SECRET=change-me-better-auth-secret

# -- Cloudinary --------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=devops

# -- Stripe (test keys em develop) -------------------------------------------
STRIPE_SECRET_KEY=sk_test_stub
STRIPE_PUBLISHABLE_KEY=pk_test_stub
STRIPE_WEBHOOK_SECRET=whsec_stub
STRIPE_PRICE_TRIAL=prod_stub
STRIPE_PRICE_BASIC=prod_stub
STRIPE_PRICE_PROFESSIONAL=prod_stub
STRIPE_PRICE_ENTERPRISE=prod_stub

# -- Mail (Mailtrap sandbox) -------------------------------------------------
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USER=
MAILTRAP_PASSWORD=

# -- AI ----------------------------------------------------------------------
ANTHROPIC_API_KEY=stub

# -- Storage / S3 ------------------------------------------------------------
AWS_ACCESS_KEY_ID=stub
AWS_SECRET_ACCESS_KEY=stub
S3_BUCKET=stub
